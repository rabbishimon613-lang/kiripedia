---
import WikiLayout from '../layouts/WikiLayout.astro';
---

<WikiLayout
  title="WikiProject Research Team — KiriPedia"
  description="The 23-role autonomous research team that builds KiriPedia from John Kiriakou's public tape. Live roster, mission board, recent activity, and statistics."
>
  <article class="wiki-article research-team">
    <h1>WikiProject Research Team</h1>

    <p class="rt-lead">
      KiriPedia is built by a standing team of small bots that churn John
      Kiriakou's public tape into an encyclopedia, eternally. The bureaus drop
      tape into the airlock; the research team drinks from it. Below is the
      live state of the team as it works — the roster, the mission board, the
      activity stream, and the running statistics. Updates every 15 seconds.
    </p>

    <div class="rt-grid">
      <!-- Pane 1 — Roster -->
      <section class="rt-pane rt-roster">
        <h2>Roster</h2>
        <table class="wikitable" id="rt-roster-table">
          <thead>
            <tr>
              <th>Role</th>
              <th>Lane</th>
              <th>State</th>
              <th>Working on</th>
              <th>Last action</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="5" class="rt-loading">Loading…</td></tr>
          </tbody>
        </table>
      </section>

      <!-- Pane 2 — Mission Board -->
      <section class="rt-pane rt-board">
        <h2>Mission board</h2>
        <div class="rt-lanes" id="rt-board">
          <div class="rt-lane" data-lane="backlog"><h3>Backlog</h3><ol></ol></div>
          <div class="rt-lane" data-lane="ready"><h3>Ready</h3><ol></ol></div>
          <div class="rt-lane" data-lane="running"><h3>Running</h3><ol></ol></div>
          <div class="rt-lane" data-lane="review"><h3>Review</h3><ol></ol></div>
          <div class="rt-lane" data-lane="blocked"><h3>Blocked</h3><ol></ol></div>
          <div class="rt-lane" data-lane="done"><h3>Done</h3><ol></ol></div>
        </div>
      </section>

      <!-- Pane 3 — Recent activity -->
      <section class="rt-pane rt-activity">
        <h2>Recent activity</h2>
        <ul class="rt-changes" id="rt-activity">
          <li class="rt-loading">Loading…</li>
        </ul>
      </section>

      <!-- Pane 4 — Statistics -->
      <section class="rt-pane rt-stats">
        <h2>Statistics</h2>
        <dl id="rt-stats">
          <dt>Articles touched today</dt><dd data-stat="articles_touched_today">—</dd>
          <dt>Words added today</dt><dd data-stat="words_added">—</dd>
          <dt>Claims filed today</dt><dd data-stat="claims_filed">—</dd>
          <dt>Suspect queue</dt><dd data-stat="suspect_queue">—</dd>
          <dt>Drift incidents today</dt><dd data-stat="drift_today">—</dd>
          <dt>Cost today</dt><dd data-stat="cost_today">—</dd>
        </dl>
        <h3>Grades</h3>
        <dl id="rt-grades"><dt class="rt-loading">Loading…</dt></dl>
        <h3>Hot keys</h3>
        <dl id="rt-keys"><dt class="rt-loading">Loading…</dt></dl>
        <p class="rt-footer-line">
          <span id="rt-cycle">cycle —</span> · <span id="rt-time">—</span> ·
          article_set_hash <code id="rt-hash">…</code>
        </p>
      </section>
    </div>
  </article>
</WikiLayout>

<style is:global>
  .research-team h1 { margin-bottom: 0.25em; }
  .research-team .rt-lead {
    border-left: 4px solid #36c;
    padding: 0.5em 0.8em;
    background: #f8f9fa;
    color: #202122;
    font-size: 0.95em;
    margin-bottom: 1.5em;
  }
  .rt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5em;
  }
  .rt-pane {
    background: #ffffff;
    border: 1px solid #a2a9b1;
    padding: 0.7em 1em 1em;
  }
  .rt-pane h2 {
    margin: 0 0 0.5em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid #a2a9b1;
    font-family: 'Linux Libertine', Georgia, serif;
    font-size: 1.15em;
    font-weight: normal;
  }
  .rt-pane h3 { font-size: 1em; margin: 0.8em 0 0.3em; }
  .rt-board, .rt-activity { grid-column: span 2; }
  @media (max-width: 900px) {
    .rt-grid { grid-template-columns: 1fr; }
    .rt-board, .rt-activity { grid-column: span 1; }
  }

  /* Pane 1 — roster */
  .rt-roster table { width: 100%; font-size: 0.88em; }
  .rt-roster td.rt-loading { padding: 1em; text-align: center; color: #54595d; }
  .rt-roster .state-working { color: #14866d; font-weight: bold; }
  .rt-roster .state-idle    { color: #72777d; }
  .rt-roster .state-off     { color: #999; font-style: italic; }
  .rt-roster .state-handoff { color: #a35200; }
  .rt-roster .lane-discovery   { color: #999; }
  .rt-roster .lane-acquisition { color: #36c; }
  .rt-roster .lane-extraction  { color: #36c; }
  .rt-roster .lane-adjudication { color: #b32424; }
  .rt-roster .lane-filing       { color: #36c; }
  .rt-roster .lane-enhancement  { color: #14866d; }
  .rt-roster .lane-patrol       { color: #a35200; }
  .rt-roster .lane-learning     { color: #6a4396; }
  .rt-roster .lane-ceremony     { color: #835c1f; }

  /* Pane 2 — board */
  .rt-lanes {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5em;
  }
  @media (max-width: 1100px) {
    .rt-lanes { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .rt-lanes { grid-template-columns: repeat(2, 1fr); }
  }
  .rt-lane {
    background: #f8f9fa;
    border: 1px solid #c8ccd1;
    padding: 0.4em 0.5em 0.5em;
    min-height: 4em;
  }
  .rt-lane h3 {
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #54595d;
    margin: 0 0 0.4em;
    border-bottom: 1px solid #c8ccd1;
    padding-bottom: 0.2em;
  }
  .rt-lane ol { list-style: none; padding: 0; margin: 0; font-size: 0.82em; }
  .rt-lane li {
    background: #fff;
    border: 1px solid #eaecf0;
    padding: 0.3em 0.4em;
    margin-bottom: 0.3em;
    border-radius: 2px;
  }
  .rt-lane li .role { color: #36c; font-weight: bold; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.04em; }
  .rt-lane li .goal { color: #202122; display: block; margin-top: 0.15em; line-height: 1.3; }
  .rt-lane li .slug { color: #72777d; font-size: 0.85em; }

  /* Pane 3 — recent activity */
  .rt-changes {
    list-style: none;
    margin: 0; padding: 0;
    font-family: 'Menlo', 'Consolas', monospace;
    font-size: 0.82em;
    max-height: 22em;
    overflow-y: auto;
  }
  .rt-changes li {
    padding: 0.2em 0.4em;
    border-bottom: 1px solid #eaecf0;
    line-height: 1.4;
  }
  .rt-changes li .ts { color: #72777d; }
  .rt-changes li .actor { color: #36c; font-weight: bold; }
  .rt-changes li .summary { color: #202122; }
  .rt-changes li a { color: #36c; }
  .rt-changes .rt-loading { color: #54595d; text-align: center; padding: 1em; }

  /* Pane 4 — statistics */
  .rt-stats dl { display: grid; grid-template-columns: 1fr auto; gap: 0.25em 1em; margin: 0 0 0.5em; font-size: 0.9em; }
  .rt-stats dt { color: #54595d; }
  .rt-stats dd { margin: 0; font-weight: bold; color: #202122; }
  .rt-stats .rt-footer-line {
    margin-top: 0.8em; padding-top: 0.5em;
    border-top: 1px solid #eaecf0;
    font-size: 0.82em; color: #54595d;
  }
  .rt-stats code { background: #f8f9fa; padding: 0 0.3em; font-size: 0.95em; }
</style>

<script is:inline>
  (function () {
    const POLL_MS = 15000;
    const fmtRel = (iso) => {
      if (!iso) return '—';
      // SQLite emits "YYYY-MM-DD HH:MM:SS" without a TZ suffix; force UTC.
      const norm = /\dZ$|[+-]\d{2}:?\d{2}$/.test(iso) ? iso : iso.replace(' ', 'T') + 'Z';
      const d = new Date(norm);
      const ageS = Math.max(0, (Date.now() - d.getTime()) / 1000);
      if (ageS < 60) return `${ageS|0}s ago`;
      if (ageS < 3600) return `${(ageS/60)|0}m ago`;
      if (ageS < 86400) return `${(ageS/3600)|0}h ago`;
      return `${(ageS/86400)|0}d ago`;
    };
    const esc = (s) => (s == null ? '' : String(s).replace(/[<>&"]/g, (c) =>
      ({ '<':'&lt;', '>':'&gt;', '&':'&amp;', '"':'&quot;' }[c])));

    async function poll() {
      try {
        const r = await fetch('/snapshot.json', { cache: 'no-store' });
        if (!r.ok) return;
        const s = await r.json();
        render(s);
      } catch (err) { /* swallow */ }
    }

    function render(s) {
      // Roster
      const rosterBody = document.querySelector('#rt-roster-table tbody');
      rosterBody.innerHTML = s.roster.map(row => `
        <tr>
          <td>${esc(row.role)}</td>
          <td class="lane-${esc(row.lane)}">${esc(row.lane)}</td>
          <td class="state-${esc(row.state)}">${esc(row.state)}</td>
          <td>${esc(row.working_on || '')}</td>
          <td>${fmtRel(row.last_action_at)}</td>
        </tr>
      `).join('');

      // Board
      for (const lane of ['backlog','ready','running','review','blocked','done']) {
        const ol = document.querySelector(`.rt-lane[data-lane="${lane}"] ol`);
        const items = s.board[lane] || [];
        if (items.length === 0) { ol.innerHTML = '<li style="color:#999;font-style:italic;border:0;background:transparent">—</li>'; continue; }
        ol.innerHTML = items.map(b => `
          <li>
            <span class="role">${esc(b.worker)}</span>
            <span class="goal">${esc(b.goal)}</span>
            ${b.slug ? `<span class="slug">${esc(b.slug)}</span>` : ''}
          </li>
        `).join('');
      }

      // Activity
      const act = document.querySelector('#rt-activity');
      act.innerHTML = (s.activity || []).map(a => `
        <li>
          <span class="ts">${esc(a.ts ? a.ts.slice(11, 19) : '')}</span>
          · <span class="actor">${esc(a.worker || a.role)}</span>
          · <span class="summary">${esc(a.summary)}</span>
          ${a.link ? ` <a href="${esc(a.link)}">→</a>` : ''}
        </li>
      `).join('') || '<li class="rt-loading">No activity yet</li>';

      // Stats
      const stats = s.stats || {};
      const setStat = (k, v) => {
        const el = document.querySelector(`#rt-stats dd[data-stat="${k}"]`);
        if (el) el.textContent = v;
      };
      setStat('articles_touched_today', stats.articles_touched_today ?? 0);
      setStat('words_added', stats.words_added ?? 0);
      setStat('claims_filed', stats.claims_filed ?? 0);
      setStat('suspect_queue', stats.suspect_queue ?? 0);
      setStat('drift_today', stats.drift_today ?? 0);
      setStat('cost_today', stats.cost_today != null ? `$${(stats.cost_today).toFixed(4)}` : '—');

      // Grades
      const gradesDl = document.querySelector('#rt-grades');
      const grades = stats.grades || {};
      const gradeOrder = ['stub','start','c','b','ga','fa'];
      const gradeRows = gradeOrder.filter(g => grades[g]).map(g => `<dt>${g.toUpperCase()}</dt><dd>${grades[g]}</dd>`);
      gradesDl.innerHTML = gradeRows.length ? gradeRows.join('') : '<dt style="color:#999">No grades yet</dt><dd></dd>';

      // Hot keys
      const keysDl = document.querySelector('#rt-keys');
      const k = stats.hot_keys || {};
      keysDl.innerHTML = `
        <dt>Cerebras</dt><dd>${k.cerebras ?? 0}</dd>
        <dt>Groq</dt><dd>${k.groq ?? 0}</dd>
        <dt>OpenRouter</dt><dd>${k.openrouter ?? 0}</dd>
      `;

      // Footer
      document.querySelector('#rt-cycle').textContent = `cycle ${s.cycle_id ?? '—'}`;
      document.querySelector('#rt-time').textContent = fmtRel(s.generated_at);
      document.querySelector('#rt-hash').textContent = (s.article_set_hash || '').slice(0, 12);
    }

    poll();
    setInterval(poll, POLL_MS);
  })();
</script>

---
import WikiLayout from '../layouts/WikiLayout.astro';
---
<WikiLayout
  title="Recent changes"
  description="Every edit landed on KiriPedia, newest first — the wiki's running ledger of what Claude has written."
>
  <div class="wiki-content">
    <h1 class="firstHeading">Recent changes</h1>
    <p class="subtitle">Every edit to every article, newest first — the wiki's running ledger</p>

    <article class="wiki-body">
      <div class="hatnote" style="padding-left:0">
        This is the public ledger of every edit landed on KiriPedia. Each row is one article touched in one commit, with the byte change, the source recording the new claims came from, and a link to the underlying diff on GitHub. The list refreshes every fifteen seconds from the same snapshot the activity log reads.
      </div>

      <p>
        KiriPedia is written by <strong>Claude</strong>, Anthropic's AI assistant — no human writes the prose. Every line here was produced by Claude reading <a href="/wiki/john-kiriakou">John Kiriakou</a> on tape, extracting a claim, grounding it against the recording, and filing it. For more on how the wiki is made, see <a href="/about">About</a>.
      </p>

      <div class="rc-toolbar">
        <div class="rc-filter-group">
          <span class="rc-filter-label">Show</span>
          <button type="button" class="rc-filter is-active" data-filter="all">All</button>
          <button type="button" class="rc-filter" data-filter="spawn">New articles</button>
          <button type="button" class="rc-filter" data-filter="amend">Amendments</button>
        </div>
        <div class="rc-meta">
          <span id="rc-counts">—</span>
          <span class="rc-sep">·</span>
          <span id="rc-updated">—</span>
        </div>
      </div>

      <ul id="rc-list" class="rc-list" aria-live="polite">
        <li class="rc-empty">Loading recent changes…</li>
      </ul>

      <p class="rc-footer-note">
        The "From <span class="rc-eg-source">source-slug</span>" column links to the recording the new claims were extracted from. The "diff" link opens the underlying commit on GitHub. Times are shown in Eastern Time. Older changes can be inspected via <a href="https://github.com/rabbishimon613-lang/kiripedia/commits/main">the full commit history</a>.
      </p>
    </article>
  </div>

  <script is:inline>
    (function () {
      var listEl = document.getElementById('rc-list');
      var countsEl = document.getElementById('rc-counts');
      var updatedEl = document.getElementById('rc-updated');
      if (!listEl) return;

      var POLL_MS = 15000;
      var REPO = 'rabbishimon613-lang/kiripedia';
      var rows = [];
      var activeFilter = 'all';
      // Slugs that are still on the picture watchlist — we cross-reference
      // recent-changes against needs-image.json so each spawn row shows
      // whether it's got a face yet or is waiting.
      var pendingPics = new Set();

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c];
        });
      }

      function fmtTime(iso) {
        try {
          var d = new Date(iso);
          if (isNaN(d.getTime())) return iso;
          return d.toLocaleString('en-US', {
            timeZone: 'America/New_York',
            month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit',
            hour12: false,
          });
        } catch (e) { return iso; }
      }

      function fmtRelative(iso) {
        try {
          var d = new Date(iso);
          var s = Math.max(0, (Date.now() - d.getTime()) / 1000);
          if (s < 60) return (s | 0) + 's ago';
          if (s < 3600) return ((s / 60) | 0) + 'm ago';
          if (s < 86400) return ((s / 3600) | 0) + 'h ago';
          return ((s / 86400) | 0) + 'd ago';
        } catch { return ''; }
      }

      function delta(r) {
        // Wikipedia shows "(+N)" or "(-N)" in green/red. We show net lines
        // because the underlying unit on disk is markdown lines (a sentence ~
        // 0–2 lines). It correlates well enough with words for a glance.
        var net = (r.added_lines || 0) - (r.deleted_lines || 0);
        var cls = net > 0 ? 'rc-add' : net < 0 ? 'rc-del' : 'rc-zero';
        var sign = net > 0 ? '+' : '';
        return '<span class="rc-delta ' + cls + '">' + sign + net + '</span>';
      }

      function rowHTML(r) {
        var diffUrl = 'https://github.com/' + REPO + '/commit/' + r.sha;
        var histUrl = 'https://github.com/' + REPO + '/commits/main/src/content/articles/' + r.slug + '.mdx';
        var src = r.from_source
          ? ' <span class="rc-src">from <a href="/sources/' + esc(r.from_source) + '">' + esc(r.from_source) + '</a></span>'
          : '';
        var kindBadge = r.kind === 'spawn'
          ? '<span class="rc-kind rc-spawn" title="New article">N</span>'
          : '<span class="rc-kind rc-amend" title="Amendment">+</span>';
        // Picture status: only applies to spawn rows. ★ = has a picture
        // already, … = pending (slug on the needs-image watchlist).
        var picBadge = '';
        if (r.kind === 'spawn') {
          picBadge = pendingPics.has(r.slug)
            ? '<a href="/needs-image" class="rc-pic rc-pic-pending" title="No picture yet — on the watchlist">…</a>'
            : '<span class="rc-pic rc-pic-done" title="Picture wired up">★</span>';
        }

        return '<li class="rc-row" data-kind="' + esc(r.kind) + '">' +
          '<span class="rc-time" title="' + esc(r.ts) + '">' + esc(fmtTime(r.ts)) + '</span>' +
          '<span class="rc-meta-links">(' +
            '<a href="' + diffUrl + '" rel="nofollow">diff</a> | ' +
            '<a href="' + histUrl + '" rel="nofollow">hist</a>' +
          ')</span>' +
          kindBadge +
          '<a href="/wiki/' + esc(r.slug) + '" class="rc-title">' + esc(r.title) + '</a>' +
          delta(r) +
          picBadge +
          src +
          '<span class="rc-summary" title="' + esc(r.summary || '') + '">' + esc(r.summary || '') + '</span>' +
          '</li>';
      }

      function render() {
        var filtered = activeFilter === 'all'
          ? rows
          : rows.filter(function (r) { return r.kind === activeFilter; });

        if (!filtered.length) {
          listEl.innerHTML = '<li class="rc-empty">No changes match this filter.</li>';
          return;
        }

        // Group by ET calendar date for Wikipedia-style day headers.
        var html = '';
        var lastDay = '';
        for (var i = 0; i < filtered.length; i++) {
          var r = filtered[i];
          var d;
          try { d = new Date(r.ts); } catch (e) { d = null; }
          var dayKey = d && !isNaN(d.getTime())
            ? d.toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
            : '';
          if (dayKey && dayKey !== lastDay) {
            html += '<li class="rc-day-header">' + esc(dayKey) + '</li>';
            lastDay = dayKey;
          }
          html += rowHTML(r);
        }
        listEl.innerHTML = html;
      }

      function updateCounts() {
        var spawn = 0, amend = 0;
        for (var i = 0; i < rows.length; i++) {
          if (rows[i].kind === 'spawn') spawn++;
          else if (rows[i].kind === 'amend') amend++;
        }
        countsEl.textContent = rows.length + ' changes · ' + spawn + ' new · ' + amend + ' amendments';
      }

      function tick() {
        // Fetch both feeds in parallel: the change ledger and the picture
        // watchlist. The watchlist updates pendingPics so each spawn row
        // shows ★ or … without needing a second render pass.
        Promise.all([
          fetch('/recent-changes.json', { cache: 'no-store' }).then(r => r.ok ? r.json() : null).catch(() => null),
          fetch('/needs-image.json', { cache: 'no-store' }).then(r => r.ok ? r.json() : null).catch(() => null),
        ]).then(function (results) {
          var snap = results[0];
          var pics = results[1];
          if (pics && Array.isArray(pics.articles)) {
            pendingPics = new Set(pics.articles.map(function (a) { return a.slug; }));
          }
          if (snap) {
            rows = snap.rows || [];
            updateCounts();
            updatedEl.textContent = 'updated ' + fmtRelative(snap.generated_at);
            render();
          } else if (!rows.length) {
            listEl.innerHTML = '<li class="rc-empty">Could not load the change feed.</li>';
          }
        });
      }

      // Wire filter buttons
      document.querySelectorAll('.rc-filter').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.rc-filter').forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          activeFilter = btn.dataset.filter;
          render();
        });
      });

      tick();
      setInterval(tick, POLL_MS);
    })();
  </script>

  <style is:global>
    .rc-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
      padding: 8px 0;
      margin: 14px 0 10px;
    }
    .rc-filter-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .rc-filter-label {
      font-size: 12px;
      color: var(--color-base--subtle);
      text-transform: uppercase;
      letter-spacing: .04em;
      margin-right: 4px;
    }
    .rc-filter {
      font: inherit;
      font-size: 12px;
      padding: 3px 10px;
      background: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-link, #36c);
      cursor: pointer;
      border-radius: 2px;
    }
    .rc-filter:hover { background: var(--color-bg-sidebar); }
    .rc-filter.is-active {
      background: var(--color-link, #36c);
      color: #fff;
      border-color: var(--color-link, #36c);
      cursor: default;
    }
    .rc-meta {
      font-size: 12px;
      color: var(--color-base--subtle);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .rc-sep { margin: 0 4px; color: var(--color-border); }

    .rc-list {
      list-style: none;
      padding: 0;
      margin: 0 0 14px;
      font-size: 13.5px;
    }
    .rc-empty {
      padding: 20px;
      text-align: center;
      color: var(--color-base--subtle);
      font-style: italic;
    }
    .rc-day-header {
      background: var(--color-bg-sidebar);
      padding: 6px 10px;
      margin-top: 14px;
      font-weight: 700;
      font-size: 13px;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-base);
    }
    .rc-day-header:first-child { margin-top: 0; }
    .rc-row {
      display: flex;
      align-items: baseline;
      gap: 6px;
      padding: 3px 10px;
      border-bottom: 1px solid var(--color-border-subtle);
      flex-wrap: wrap;
    }
    .rc-time {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base--subtle);
      font-size: 12px;
      white-space: nowrap;
    }
    .rc-meta-links {
      flex: 0 0 auto;
      font-size: 12px;
      color: var(--color-base--subtle);
    }
    .rc-meta-links a {
      color: var(--color-link, #36c);
      text-decoration: none;
    }
    .rc-meta-links a:hover { text-decoration: underline; }
    .rc-kind {
      flex: 0 0 auto;
      display: inline-block;
      width: 16px;
      height: 16px;
      line-height: 16px;
      text-align: center;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 11px;
      border-radius: 2px;
    }
    .rc-spawn { background: #0a8754; color: #fff; }
    .rc-amend { background: #b85; color: #fff; }
    .rc-title {
      flex: 0 1 auto;
      font-weight: 600;
      color: var(--color-link, #36c);
      text-decoration: none;
    }
    .rc-title:hover { text-decoration: underline; }
    .rc-delta {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      font-weight: 700;
    }
    .rc-add { color: var(--color-success, #0a8754); }
    .rc-del { color: #c00; }
    .rc-zero { color: var(--color-base--subtle); }
    .rc-pic {
      flex: 0 0 auto;
      font-size: 13px;
      text-decoration: none;
      line-height: 1;
      margin-left: 2px;
    }
    .rc-pic-done    { color: #d6a000; }    /* ★ amber for has-picture */
    .rc-pic-pending {
      color: var(--color-base--subtle);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 14px;
      letter-spacing: -1px;
    }
    .rc-pic-pending:hover { color: var(--color-link, #36c); }
    .rc-src {
      flex: 0 1 auto;
      font-size: 12px;
      color: var(--color-base--subtle);
    }
    .rc-src a { color: var(--color-base--subtle); }
    .rc-src a:hover { color: var(--color-link); text-decoration: underline; }
    .rc-summary {
      flex: 1 1 200px;
      font-size: 12px;
      color: var(--color-base--subtle);
      font-style: italic;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rc-eg-source {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base);
    }
    .rc-footer-note {
      font-size: 12px;
      color: var(--color-base--subtle);
      margin-top: 14px;
      line-height: 1.5;
    }

    @media (max-width: 720px) {
      .rc-toolbar { gap: 10px; }
      .rc-filter-group { width: 100%; }
      .rc-row { padding: 6px 10px; gap: 5px; row-gap: 3px; }
      .rc-summary {
        flex-basis: 100%;
        white-space: normal;
        line-height: 1.4;
        margin-left: 22px;
      }
      .rc-time, .rc-meta-links { font-size: 11.5px; }
      .rc-title { font-size: 14px; }
      .rc-day-header { font-size: 13.5px; padding: 8px 10px; }
    }
  </style>
</WikiLayout>

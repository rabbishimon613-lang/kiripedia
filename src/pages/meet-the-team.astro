---
import WikiLayout from '../layouts/WikiLayout.astro';
import { BOTS } from '../data/team.mjs';

// Group bots by role for the roster description list.
const byRole = {};
for (const b of BOTS) (byRole[b.role] ??= []).push(b);
const roleOrder = ['Discovery', 'Triage', 'Vetting', 'Transcription', 'Claim Extraction',
                   'Verification', 'Publishing', 'Steady-State', 'Cohesion'];
---
<WikiLayout
  title="Meet the team"
  description="The autonomous editorial bureau that builds KiriPedia — fourteen bots, each with one job."
>
  <div class="wiki-content">
    <h1 class="firstHeading">Meet the team</h1>
    <p class="subtitle">The autonomous editorial bureau that builds KiriPedia, with no human in the loop</p>

    <article class="wiki-body">
      <div class="hatnote" style="padding-left:0">
        Every article on KiriPedia is written, cited, and edited by this autonomous workforce. The bureau runs continuously on a public GitHub repository and commits its work back to the wiki without supervision. This page shows the office in real time.
      </div>

      <p>
        <strong>KiriPedia</strong> is built by a small editorial bureau of specialized software agents. Each agent does one part of the job — discovering new <a href="/wiki/john-kiriakou">John Kiriakou</a> appearances, transcribing them, extracting verifiable claims, checking those claims against the source transcripts, and merging the surviving claims into the right article. The pixel office below shows every agent at its desk, walking between desks when work is being handed off.
      </p>

      <p>
        Nothing on the site is published until the <em>Grounding Reviewer</em> confirms that the underlying quote really appears in the cited transcript at the cited timestamp. Claims that fail the check are quarantined permanently rather than escalated to a human — the bureau is, by design, completely unsupervised.
      </p>

      <h2 id="the-office">The office</h2>

      <figure id="mtt-office-figure" class="office-figure" style="margin:0 0 18px;border:1px solid var(--color-border);background:var(--color-bg-infobox);padding:8px;max-width:100%;">
        <iframe
          src="/office/index.html?embed=1"
          title="KiriPedia editorial bureau — live pixel office"
          class="office-iframe"
          style="width:100%;aspect-ratio:21/21;border:0;display:block;background:#1a1a1a;min-height:560px;"
        ></iframe>
        <figcaption>
          The bureau at work. Each desk belongs to one named agent. Hover any character in the office for its current activity. Outgoing handoffs animate as short walks between desks. The office refreshes every fifteen seconds from the same snapshot file the activity log reads.
        </figcaption>
      </figure>

      <h2 id="activity-log">Activity log</h2>

      <p>
        Recent events from the bureau, newest first, idle desks omitted. Timestamps are shown in 24-hour format as recorded by the bureau. The log refreshes every fifteen seconds.
      </p>

      <div class="log-wrap">
        <div id="mtt-log" class="wiki-log-feed">
          <div class="log-empty">Loading…</div>
        </div>
      </div>
      <div id="mtt-log-footer" class="log-footer">Last poll — · next in —</div>

      <h2 id="roster">The full roster</h2>

      <p>
        Fourteen agents across nine roles. During the initial backfill of John Kiriakou's existing public appearances — roughly fifteen thousand clips spanning two decades — the discovery, triage, transcription, cataloging, and review desks are constantly busy. The steady-state pool (Deepener, Cross-Source Enricher, Article Weaver) takes over once the backfill is drained and keeps the bureau busy refining existing articles.
      </p>

      {roleOrder.filter(r => byRole[r]).map(role => (
        <section class="role-section">
          <h3>{role}</h3>
          <dl class="role-dl">
            {byRole[role].map(b => (
              <>
                <dt>
                  <span class="role-dot" style={`background:${b.color}`}></span>
                  {b.name}
                </dt>
                <dd>{b.description}</dd>
              </>
            ))}
          </dl>
        </section>
      ))}

      <h2 id="how-it-runs">How the bureau runs</h2>

      <p>
        The bureau operates as a pipeline of cron jobs running on a public GitHub repository. Discovery fires every six hours; triage and the full ingest cycle fire every fifteen minutes; the Article Weaver runs once a day. All language-model work is done by free worker models (Cerebras and Groq, via key rotation); all verification is done by deterministic code, not by AI judgment.
      </p>

      <p>
        Truth lives in a single SQLite database that all agents read and write. Only the <em>WikiProject Coordinator</em> ever touches the git repository, which means there are never merge conflicts between agents and the wiki is always in a coherent state. Claims that fail the grounding check enter a quarantine table that is never cleared and never reviewed — quarantine, by deliberate design, is a dead letter, not an inbox.
      </p>

      <p>
        For the underlying article-writing methodology — citation format, doctrine, source acceptance rules — see <a href="/about">About KiriPedia</a>. For the index of every transcript the bureau has consumed, see the <a href="/sources">Source index</a>.
      </p>
    </article>
  </div>

  <script is:inline>
    // Activity log — polls the same snapshot file the office iframe reads.
    (function () {
      var feed = document.getElementById('mtt-log');
      var footer = document.getElementById('mtt-log-footer');
      if (!feed) return;
      var seen = new Set();
      var log = [];
      var POLL_MS = 15000;
      var lastPoll = 0;
      var firstRender = true;
      function fmtTime(ts) {
        try {
          if (!ts) return '';
          var s = String(ts);
          // ISO with T and Z → parse as UTC, render in local 24h.
          if (/T/.test(s) && /Z|[+-]\d\d:?\d\d$/.test(s)) {
            var d = new Date(s);
            if (!isNaN(d.getTime())) {
              return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
            }
          }
          // Otherwise: snapshot string is already 24h "YYYY-MM-DD HH:MM:SS" — extract literally.
          var m = s.match(/(\d{2}):(\d{2}):(\d{2})/);
          if (m) return m[1] + ':' + m[2] + ':' + m[3];
          return s;
        } catch (e) { return ts; }
      }
      function esc(s) { return String(s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      }); }
      function statusOf(action) {
        if (!action) return 'idle';
        var a = String(action).trim().toLowerCase();
        if (a === '' || a === 'idle') return 'idle';
        return 'working';
      }
      function rowHTML(e, flash) {
        var status = statusOf(e.action);
        var actionText = e.action && String(e.action).trim() ? e.action : 'idle';
        return '<div class="log-row' + (flash ? ' log-flash' : '') + '">' +
          '<span class="log-dot status-' + status + '">●</span>' +
          '<span class="log-time">' + fmtTime(e.ts) + '</span>' +
          '<span class="log-who">' + esc(e.who) + '</span>' +
          '<span class="log-arrow">·</span>' +
          '<span class="log-action">' + esc(actionText) + '</span>' +
          '</div>';
      }
      function render(newCount) {
        if (log.length === 0) {
          feed.innerHTML = '<div class="log-empty">No activity yet. The bureau is quiet.</div>';
          return;
        }
        var html = '';
        for (var i = 0; i < log.length; i++) {
          var flash = !firstRender && i < newCount;
          html += rowHTML(log[i], flash);
        }
        feed.innerHTML = html;
        firstRender = false;
      }
      function tick() {
        lastPoll = Date.now();
        fetch('/botnet-snapshot.json', { cache: 'no-store' }).then(function (r) {
          if (!r.ok) throw new Error('no snapshot');
          return r.json();
        }).then(function (snap) {
          var added = 0;
          (snap.bots || []).forEach(function (b) {
            if (!b.ts) return;
            // Action-only feed: skip idle bots entirely. Going-idle is not an event.
            if (statusOf(b.action) !== 'working') return;
            var key = b.ts + '::' + b.key + '::' + b.action;
            if (seen.has(key)) return;
            seen.add(key);
            log.unshift({ ts: b.ts, who: b.label || b.key, action: b.action });
            added++;
          });
          if (log.length > 100) log.length = 100;
          render(added);
        }).catch(function () { /* network blip */ });
      }
      function updateFooter() {
        if (!footer || !lastPoll) return;
        var ago = Math.max(0, Math.floor((Date.now() - lastPoll) / 1000));
        var next = Math.max(0, Math.floor(POLL_MS / 1000 - ago));
        footer.textContent = 'Last poll ' + ago + 's ago · next in ' + next + 's';
      }
      tick();
      setInterval(tick, POLL_MS);
      setInterval(updateFooter, 1000);
    })();

    // Mobile tap to open office in a new tab. Avoids the iframe-in-iframe race
    // that stalled the overlay on iOS Safari.
    (function () {
      if (!window.matchMedia || !window.matchMedia('(pointer: coarse)').matches) return;
      var figure = document.getElementById('mtt-office-figure');
      if (!figure) return;

      var guard = document.createElement('div');
      guard.className = 'mtt-tap-guard';
      guard.setAttribute('aria-label', 'Open office in new tab');
      figure.style.position = 'relative';
      figure.appendChild(guard);

      var moved = false;
      guard.addEventListener('touchstart', function () { moved = false; }, { passive: true });
      guard.addEventListener('touchmove', function () { moved = true; }, { passive: true });
      guard.addEventListener('click', function (e) {
        if (moved) return;
        e.preventDefault();
        e.stopPropagation();
        window.open('/office/index.html?embed=1', '_blank');
      });
    })();
  </script>

  <style is:global>
    .office-figure {
      margin: 0 0 18px;
      border: 1px solid var(--color-border);
      background: var(--color-bg-infobox);
      padding: 8px;
      max-width: 100%;
    }
    .office-iframe {
      width: 100%;
      height: 640px;
      border: 0;
      display: block;
      background: #1a1a1a;
    }
    @media (max-width: 720px) {
      .office-iframe { height: 480px; }
    }
    .office-figure figcaption {
      font-size: 12px;
      color: var(--color-base--subtle);
      margin-top: 8px;
      line-height: 1.45;
      text-align: center;
    }

    .log-wrap {
      border: 1px solid var(--color-border);
      background: var(--color-bg-infobox);
      max-height: 360px;
      overflow-y: auto;
      margin-bottom: 4px;
    }
    .wiki-log-feed { font-size: 13px; }
    .wiki-log-feed .log-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 4px 10px;
      border-bottom: 1px solid var(--color-border-subtle);
      background: transparent;
      transition: background-color 2s linear;
    }
    .wiki-log-feed .log-row.log-flash { background: #fff3a8; transition: none; }
    .wiki-log-feed .log-dot {
      flex: 0 0 auto;
      font-size: 10px;
      line-height: 1;
    }
    .wiki-log-feed .log-dot.status-working { color: var(--color-success, #0a8754); }
    .wiki-log-feed .log-dot.status-idle { color: var(--color-base--subtle, #999); }
    .wiki-log-feed .log-time {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base--subtle);
      white-space: nowrap;
    }
    .wiki-log-feed .log-who {
      flex: 0 0 auto;
      font-weight: 600;
      color: var(--color-base);
      white-space: nowrap;
    }
    .wiki-log-feed .log-arrow {
      flex: 0 0 auto;
      color: var(--color-base--subtle);
    }
    .wiki-log-feed .log-action {
      flex: 1 1 auto;
      color: var(--color-base);
      word-break: break-word;
    }
    .wiki-log-feed .log-empty {
      text-align: center;
      color: var(--color-base--subtle);
      font-style: italic;
      padding: 20px;
    }
    .log-footer {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: var(--color-base--subtle);
      margin: 0 0 18px;
      padding: 2px 2px;
    }

    /* Mobile tap guard — opens office in a new tab */
    .mtt-tap-guard {
      position: absolute;
      inset: 8px;
      z-index: 5;
      cursor: pointer;
      background: transparent;
    }

    .role-section { margin: 18px 0; }
    .role-section h3 {
      font-size: 16px;
      border-bottom: 1px solid var(--color-border-subtle);
      padding-bottom: 4px; margin-bottom: 10px;
    }
    .role-dl {
      display: grid;
      grid-template-columns: 250px 1fr;
      gap: 6px 16px; margin: 0;
    }
    .role-dl dt {
      font-weight: 600; color: var(--color-base);
      display: flex; align-items: center; gap: 8px;
    }
    .role-dl dd { margin: 0 0 6px; color: var(--color-base); }
    .role-dot {
      display: inline-block; width: 10px; height: 10px;
      border-radius: 50%;
      border: 1px solid var(--color-base--subtle);
      flex-shrink: 0;
    }
    @media (max-width: 720px) {
      .role-dl { grid-template-columns: 1fr; }
      .wiki-log-feed .log-row { flex-wrap: wrap; }
    }
  </style>
</WikiLayout>

---
import WikiLayout from '../layouts/WikiLayout.astro';
---
<WikiLayout
  title="Meet the team"
  description="The autonomous editorial bureau that builds KiriPedia — a standing research team of small bots that read John Kiriakou's tape and write the encyclopedia, around the clock."
>
  <div class="wiki-content">
    <h1 class="firstHeading">Meet the team</h1>
    <p class="subtitle">The standing research team that turns John Kiriakou's tape into an encyclopedia, around the clock</p>

    <article class="wiki-body">
      <div class="hatnote" style="padding-left:0">
        KiriPedia is written and maintained by an autonomous research team of small specialised bots. The team runs twenty-four hours a day on a public repository and commits its work back to the wiki without supervision. Everything on this page — the mission board, the live stats, the activity log, the words-written chart, the key health panel — refreshes every fifteen seconds from the team's own running state.
      </div>

      <p>
        <strong>KiriPedia</strong> is a Wikipedia that writes itself from one man's mouth. A team of role-narrow bots churns <a href="/wiki/john-kiriakou">John Kiriakou</a>'s full body of public tape — every interview, podcast, livestream, short — into a dense, encyclopedic wiki. New tape comes in, old tape gets re-read every time the article set grows, nothing decays, nothing gets forgotten. No humans in the loop except for doctrine calls.
      </p>

      <p>
        Two engines turn at the same time. The <strong>fresh-tape pipeline</strong> takes whatever lands in the airlock — transcribe, extract claims, ground them against the recording, file them into the right article. The <strong>eternal re-churn</strong> walks back through old transcripts every time the article set changes shape, and every passage gets a verdict on whether it now justifies a new article, an amendment to an existing one, or a note for later. Around both engines, a patrol watches for citation loss, style drift and shape problems, and a ceremony desk promotes articles up the quality grades.
      </p>

      <p>
        Nothing reaches the wiki until the <em>Grounding Reviewer</em> confirms the underlying quote actually appears in the cited recording at the cited timestamp. Claims that fail the check are quarantined permanently rather than escalated to a person — quarantine is a dead letter, never an inbox.
      </p>

      <h2 id="mission-board">Mission board</h2>

      <p>
        Work in flight, organised by lane. The <em>Triage Patroller</em> files briefs into the backlog when it spots something the team should look at; bots claim those briefs into the running lane; finished briefs land in done. Updates every fifteen seconds.
      </p>

      <div class="rt-lanes" id="rt-board">
        <div class="rt-lane" data-lane="backlog"><h3>Backlog</h3><ol></ol></div>
        <div class="rt-lane" data-lane="ready"><h3>Ready</h3><ol></ol></div>
        <div class="rt-lane" data-lane="running"><h3>Running</h3><ol></ol></div>
        <div class="rt-lane" data-lane="review"><h3>Review</h3><ol></ol></div>
        <div class="rt-lane" data-lane="blocked"><h3>Blocked</h3><ol></ol></div>
        <div class="rt-lane" data-lane="done"><h3>Done</h3><ol></ol></div>
      </div>

      <h2 id="live-stats">Live statistics</h2>

      <div class="rt-stats-box">
        <dl id="rt-stats">
          <dt>Articles touched today</dt><dd data-stat="articles_touched_today">—</dd>
          <dt>Words added today</dt><dd data-stat="words_added">—</dd>
          <dt>Claims filed today</dt><dd data-stat="claims_filed">—</dd>
          <dt>Suspect queue</dt><dd data-stat="suspect_queue">—</dd>
          <dt>Drift incidents today</dt><dd data-stat="drift_today">—</dd>
        </dl>
        <h3>Article grades</h3>
        <dl id="rt-grades"><dt class="rt-loading">Loading…</dt></dl>
        <p class="rt-footer-line">
          <span id="rt-cycle">cycle —</span> · updated <span id="rt-time">—</span> ·
          article_set_hash <code id="rt-hash">…</code>
        </p>
      </div>

      <h2 id="activity-log">Activity log</h2>

      <div id="mtt-orders-banner" class="orders-banner" style="display:none">
        <span class="orders-date" id="mtt-orders-date"></span>
        <span class="orders-text" id="mtt-orders-text"></span>
      </div>

      <p>
        Recent events from the team, newest first. Timestamps are shown in Eastern Time. The log refreshes every fifteen seconds.
      </p>

      <div class="log-wrap">
        <div id="mtt-log" class="wiki-log-feed">
          <div class="log-empty">Loading…</div>
        </div>
      </div>
      <div id="mtt-log-footer" class="log-footer">Last poll — · next in —</div>

      <h2 id="words-written">Words written</h2>

      <div id="mtt-words-box" class="words-box">
        <div class="words-today-row">
          <span class="words-today-label">Today</span>
          <span id="mtt-words-today" class="words-today-count">—</span>
          <span class="words-today-unit">words</span>
        </div>
        <div id="mtt-words-chart" class="words-chart" aria-label="Words written last 7 days">
          <div class="words-chart-bars" id="mtt-bars"></div>
          <div class="words-chart-labels" id="mtt-labels"></div>
        </div>
      </div>

      <h2 id="key-health">Key health</h2>

      <div id="mtt-keys-box" class="keys-box">
        <div class="keys-probe-row">
          <span class="keys-probe-label">Last probe</span>
          <span id="mtt-probe-time" class="keys-probe-time">—</span>
        </div>
        <div id="mtt-provider-grid" class="provider-grid"></div>
        <div class="keys-stats-row">
          <span class="keys-stat"><span id="mtt-calls-today" class="keys-stat-val">—</span> calls today</span>
          <span class="keys-stat-sep">·</span>
          <span class="keys-stat"><span id="mtt-cost-today" class="keys-stat-val">—</span> est. cost</span>
          <span class="keys-stat-sep">·</span>
          <span class="keys-stat"><span id="mtt-dead-keys" class="keys-stat-val">—</span> dead keys</span>
        </div>
      </div>

      <h2 id="pardon">Pardon and support</h2>

      <p>
        John Kiriakou served twenty-three months in federal prison following his 2012 prosecution under the <a href="/wiki/espionage-act">Espionage Act</a>. As a convicted federal felon he continues to be barred from voting, from exercising his Second Amendment right to keep and bear arms, and from receiving the federal pension he had earned over his fourteen years at the <a href="/wiki/cia">Central Intelligence Agency</a>. A presidential pardon would restore all three. Readers who wish to petition for a pardon on his behalf may do so by contacting their elected federal representatives.
      </p>

      <p>
        Readers who wish to support the continued work of KiriPedia — further article writing, ongoing refinement of existing articles, ingestion of new source material, and hosting costs — may send Bitcoin contributions to the following address:
      </p>

      <pre class="btc-address">bc1q0xcvzfrzmw482scntfq8l0mex90vfmyy05c83c</pre>

      <h2 id="roster">The full roster</h2>

      <p>
        Twenty-three roles, organised into nine lanes across two engines and a patrol. Each role is one process, doing one job, on a long loop. Where you see <span class="dot-on" aria-hidden="true">●</span> the desk is currently turning; where you see <span class="dot-off" aria-hidden="true">●</span> the desk is intentionally dark while the team finishes its first month of work on the existing eighty-eight hours of tape.
      </p>

      <section class="role-section">
        <h3>Future Bureau &mdash; discovery, watching forward</h3>
        <p class="lane-blurb">Four desks that go out and find new Kiriakou tape as it lands. Currently dark — the team is focused on re-churning the existing archive first; the bureaus light up at the end of the first-month mission.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-off"></span>Channel Crawler</dt>
          <dd>Walks the full upload history of every channel known to have ever hosted Kiriakou, then follows each new co-guest's home channel one hop further. No search API, no quota.</dd>
          <dt><span class="role-dot dot-off"></span>Seed Gardener</dt>
          <dd>Curates the seed list: adds new channels when a Kiriakou appearance proves them, removes channels that have gone dormant or off-mission. Keeps the Crawler aimed at live ground.</dd>
          <dt><span class="role-dot dot-off"></span>Podcast Sweeper</dt>
          <dd>Polls RSS feeds for shows that publish Kiriakou audio-first. About half his appearances never make it to video, so a separate sweep keeps the audio side covered.</dd>
          <dt><span class="role-dot dot-off"></span>Archive Diver</dt>
          <dd>Past Bureau counterpart to the others. Goes after dead RT content, mirrors on archive.org, and clips that have been silently removed from their original hosts.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Acquisition &mdash; getting the tape into the building</h3>
        <p class="lane-blurb">Once a recording is on the list, this lane converts it into clean, timestamped, deduplicated text the rest of the team can work with.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Scribe</dt>
          <dd>Pulls auto-captions; if those are bad or missing, escalates to manual subtitles, then to a small open-source speech-to-text model on the audio itself. Outputs a clean transcript with sponsor segments removed.</dd>
          <dt><span class="role-dot dot-off"></span>Fingerprinter</dt>
          <dd>Collapses re-uploads. The same Rogan clip might exist as fifteen YouTube uploads under fifteen titles; this desk fingerprints the audio and the transcript shingles so they all resolve to one recording. Wakes up once the Future Bureau starts.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Extraction &mdash; reading the transcript for claims</h3>
        <p class="lane-blurb">A transcript is raw material. This lane turns it into the unit the wiki cares about: a single factual claim with the exact quote, the timestamp it came from, and the article it belongs in.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Cataloger</dt>
          <dd>Reads through a finished transcript and pulls every factual claim worth keeping, attaching the quote, the timestamp, and a candidate article slug to each one.</dd>
          <dt><span class="role-dot dot-off"></span>Passage Embedder</dt>
          <dd>Indexes each passage in a semantic store so the Re-Reader and Enricher can ask "where else in the corpus did Kiriakou touch this idea?" Comes online with the eternal re-read engine at full scale.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Adjudication &mdash; deciding what's safe to publish</h3>
        <p class="lane-blurb">Three desks stand between an extracted claim and the wiki. Each enforces one rule, mechanically.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Grounding Reviewer</dt>
          <dd>Confirms the quoted words actually appear in the transcript at the stated timestamp, that the source is on the trusted list, and that the claim is about a subject Kiriakou is discussing — not a claim Kiriakou is making about himself. Anything that fails goes into permanent quarantine.</dd>
          <dt><span class="role-dot dot-on"></span>Discretion Warden</dt>
          <dd>Mirrors Kiriakou's own silences. If the corpus declines to name someone across many mentions of a topic, the wiki must also decline to name them; this desk checks that rule on every claim before filing.</dd>
          <dt><span class="role-dot dot-on"></span>First/Third Splitter</dt>
          <dd>Tags every surviving claim as either <em>witnessed</em> (Kiriakou was personally present) or <em>relayed</em> (he is reporting what someone else said). Relayed claims get the "according to Kiriakou" attribution prefix on the wiki; witnessed claims don't.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Filing &mdash; writing it onto the wiki</h3>
        <p class="lane-blurb">Only one desk on the team ever touches the git repository, which kills merge conflicts at the root.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>WikiProject Coordinator</dt>
          <dd>Gathers every claim that has cleared adjudication, sorts them by article, drafts the additions, and commits them. Works alone and in sequence — there are never two Coordinators running at once.</dd>
          <dt><span class="role-dot dot-on"></span>Triage Patroller</dt>
          <dd>Watches the wiki for anomalies — stubs that have grown enough to need promoting, orphan articles with no inbound links, articles where the cadence of new claims has stalled — and files briefs for the rest of the team to pick up.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Enhancement &mdash; making filed articles denser and tighter</h3>
        <p class="lane-blurb">Filing an article is the start, not the finish. Four desks keep coming back to existing articles to deepen them, cross-link them, and rewrite them when the shape no longer fits.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Deepener</dt>
          <dd>Goes back through transcripts that are already cataloged, listening for offhand remarks and qualifications buried in long answers. The first pass catches the obvious; the Deepener catches what the first pass missed.</dd>
          <dt><span class="role-dot dot-on"></span>Enricher</dt>
          <dd>Looks across the full corpus and asks, every time a subject comes up in a different recording, whether the article about that subject knows about it. When it finds a gap, it drafts the addition.</dd>
          <dt><span class="role-dot dot-on"></span>Weaver</dt>
          <dd>Selects a cluttered article — long lists of fragments, no clear sections — and rewrites its structure into a coherent narrative. Every quote and citation is preserved exactly; only the shape changes.</dd>
          <dt><span class="role-dot dot-on"></span>Reweaver</dt>
          <dd>The Weaver's second pass. When an article has been Weaved before but has since accumulated enough new claims to outgrow its structure again, the Reweaver retakes the whole piece.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Patrol &mdash; the cops on the beat</h3>
        <p class="lane-blurb">Three desks that watch the wiki for backsliding. They don't file new claims; they enforce that filed work doesn't decay.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Diff Sentinel</dt>
          <dd>Reads every commit as it lands, watching for citation loss and "hedge rise" — the slow drift where direct claims become qualified into uselessness. Reverts the offending edit and files a brief.</dd>
          <dt><span class="role-dot dot-on"></span>Shape Auditor</dt>
          <dd>Audits the table-of-contents shape of every article. Flags lopsided pieces (one giant section, six empty stubs) and articles that have outgrown their original outline.</dd>
          <dt><span class="role-dot dot-on"></span>MoS Enforcer</dt>
          <dd>The Manual of Style desk. Mechanical things — citation format, heading levels, link style, date format. Boring, important, runs on every article.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Learning &mdash; the eternal re-read engine</h3>
        <p class="lane-blurb">The wiki is never "done." Every time a new article spawns, every existing transcript becomes worth re-reading under the new lens. This lane is what makes that loop close.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Re-Reader</dt>
          <dd>Walks old transcripts under the current article set. Every passage carries a stamp of the last article-set shape it was evaluated under; when that shape changes, the stamp goes stale and the passage is eligible to be re-read. Verdicts: spawn a new article, amend an existing one, file the entity for later, or reject.</dd>
          <dt><span class="role-dot dot-off"></span>Contradiction Scout</dt>
          <dd>Walks the corpus comparing Kiriakou's own statements across recordings. Flags places where he has plainly changed his position over time and routes them to a dedicated handling track. Comes online once the Re-Reader has caught up.</dd>
        </dl>
      </section>

      <section class="role-section">
        <h3>Ceremony &mdash; the quality grades</h3>
        <p class="lane-blurb">One desk, one job: deciding when an article is good enough to promote up the Wikipedia-style quality ladder.</p>
        <dl class="role-dl">
          <dt><span class="role-dot dot-on"></span>Promotion Committee</dt>
          <dd>Once a day, reviews articles that meet the next-tier thresholds (length, citations, coverage, recent edits) and promotes them from Stub → Start → C → B → Good Article → Featured Article. Each promotion is logged on the article's talk page.</dd>
        </dl>
      </section>

      <h2 id="how-it-runs">How the team runs</h2>

      <p>
        The team is supervised by a single long-lived process that never exits. Every desk is a separate program, each one launched on its own cadence — some fire every few minutes, some every twenty, some once a day. Nothing is scheduled by hand; the supervisor knows what each desk costs and how often it makes sense to run.
      </p>

      <p>
        All language-model work is done by free worker models — currently <em>Gemini 2.5 Flash</em> for long-context reads, plus <em>Cerebras</em>, <em>Groq</em>, and <em>OpenRouter</em> for everything else, with automatic rotation across multiple keys per provider and automatic failover when any one provider is throttled. All verification is done by deterministic code, not by AI judgment. The model is never the source of truth; the recording is.
      </p>

      <p>
        Truth lives in a single SQLite database that every desk reads and writes. The <em>WikiProject Coordinator</em> is the only role that touches git, which is why the wiki is always in a coherent state and there are never merge conflicts between desks. Claims that fail the grounding check enter a quarantine table that is never cleared and never reviewed — by deliberate design, a dead letter, not an inbox.
      </p>

      <p>
        For the article-writing methodology itself — citation format, doctrine, source acceptance rules — see <a href="/about">About KiriPedia</a>. For the index of every recording the team has consumed, see the <a href="/sources">Source index</a>.
      </p>
    </article>
  </div>

  <script is:inline>
    // Words-written widget — reads words_today + words_7d from the same snapshot.
    (function () {
      var todayEl = document.getElementById('mtt-words-today');
      var barsEl  = document.getElementById('mtt-bars');
      var labelsEl = document.getElementById('mtt-labels');
      if (!todayEl || !barsEl) return;
      var DAY_ABBR = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      function renderWords(snap) {
        var today = snap.words_today || 0;
        todayEl.textContent = today.toLocaleString();
        var days = snap.words_7d || [];
        if (!days.length) return;
        var max = Math.max(1, Math.max.apply(null, days.map(function(d){return d.words;})));
        var barsHtml = '', labelsHtml = '';
        for (var i = 0; i < days.length; i++) {
          var d = days[i];
          var pct = Math.round((d.words / max) * 100);
          var isToday = (i === days.length - 1);
          barsHtml += '<div class="wc-bar-wrap' + (isToday ? ' wc-today' : '') + '" title="' + d.date + ': ' + d.words.toLocaleString() + ' words">' +
            '<div class="wc-bar" style="height:' + pct + '%"></div>' +
            '</div>';
          var dayName = DAY_ABBR[new Date(d.date + 'T12:00:00Z').getUTCDay()];
          labelsHtml += '<span class="wc-label' + (isToday ? ' wc-today-label' : '') + '">' + dayName + '</span>';
        }
        barsEl.innerHTML = barsHtml;
        labelsEl.innerHTML = labelsHtml;
      }
      function fetchWords() {
        fetch('/botnet-snapshot.json', { cache: 'no-store' }).then(function(r){
          if (!r.ok) return;
          return r.json();
        }).then(function(snap) {
          if (!snap) return;
          if (snap.words_7d) renderWords(snap);
          if (window._renderOrders) window._renderOrders(snap);
          if (window._renderKeys) window._renderKeys(snap);
        }).catch(function(){});
      }
      fetchWords();
      setInterval(fetchWords, 15000);
    })();

    // Key health widget — reads office_state from the snapshot.
    (function () {
      var gridEl    = document.getElementById('mtt-provider-grid');
      var probeEl   = document.getElementById('mtt-probe-time');
      var callsEl   = document.getElementById('mtt-calls-today');
      var costEl    = document.getElementById('mtt-cost-today');
      var deadEl    = document.getElementById('mtt-dead-keys');
      if (!gridEl) return;
      var PRETTY = {
        'groq:gpt-oss-120b':    'GPT-OSS 120B',
        'groq:gpt-oss-20b':     'GPT-OSS 20B',
        'groq:llama-4-scout':   'Llama 4 Scout',
        'groq:llama-3.3-70b':   'Llama 3.3 70B',
        'cerebras:qwen-3-coder':'Qwen-3 Coder',
      };
      function fmtProbeTime(iso) {
        try {
          var d = new Date(iso);
          if (isNaN(d)) return iso;
          var ago = Math.floor((Date.now() - d) / 60000);
          return ago < 2 ? 'just now' : ago + 'm ago';
        } catch { return iso; }
      }
      function renderKeys(snap) {
        var os = snap.office_state;
        if (!os) return;
        var results = (os.last_probe && os.last_probe.results) || [];
        if (probeEl && os.last_probe) probeEl.textContent = fmtProbeTime(os.last_probe.at);
        if (callsEl) callsEl.textContent = (os.calls_today || 0).toLocaleString();
        if (costEl)  costEl.textContent  = os.cost_today < 0.01
          ? '<$0.01'
          : '$' + os.cost_today.toFixed(3);
        if (deadEl)  deadEl.textContent  = (os.dead_keys || 0);
        var html = '';
        for (var i = 0; i < results.length; i++) {
          var r = results[i];
          var ok = r.status === 'ok';
          var label = PRETTY[r.id] || r.id;
          var provider = r.id.split(':')[0];
          html += '<div class="provider-row">' +
            '<span class="provider-dot ' + (ok ? 'prov-ok' : 'prov-fail') + '">●</span>' +
            '<span class="provider-name">' + label + '</span>' +
            '<span class="provider-tag">' + provider + '</span>' +
            '<span class="provider-status ' + (ok ? 'prov-ok' : 'prov-fail') + '">' + (ok ? 'up' : 'down') + '</span>' +
            ((!ok && r.code) ? '<span class="provider-code">' + r.code + '</span>' : '') +
            '</div>';
        }
        gridEl.innerHTML = html || '<span class="keys-empty">No probe data yet.</span>';
      }
      window._renderKeys = renderKeys;
    })();

    // Orders of the Day banner — reads orders_today from the snapshot.
    (function () {
      var banner = document.getElementById('mtt-orders-banner');
      var dateEl = document.getElementById('mtt-orders-date');
      var textEl = document.getElementById('mtt-orders-text');
      if (!banner) return;
      function renderOrders(snap) {
        var o = snap.orders_today;
        if (!o) return;
        var pct = Math.round((o.total_words / o.goal) * 100);
        dateEl.textContent = 'Orders · ' + o.date + ' · ' + o.total_words.toLocaleString() + ' / ' + o.goal.toLocaleString() + ' words (' + pct + '%)';
        // Shorten the directive to the first sentence for the banner
        var short = (o.directive || '').split(/\.\s/)[0].replace(/^TODAY'S ORDERS \([^)]+\):\s*/i, '');
        textEl.textContent = short + '.';
        banner.style.display = '';
      }
      // Piggyback on the snapshot fetch — called after the snapshot loads
      window._renderOrders = renderOrders;
    })();

    // Mission board + live stats — polls the research-team snapshot.
    (function () {
      var board = document.getElementById('rt-board');
      var statsBox = document.getElementById('rt-stats');
      if (!board && !statsBox) return;
      var POLL_MS = 15000;
      function fmtRel(iso) {
        if (!iso) return '—';
        var norm = /\dZ$|[+-]\d{2}:?\d{2}$/.test(iso) ? iso : iso.replace(' ', 'T') + 'Z';
        var d = new Date(norm);
        var ageS = Math.max(0, (Date.now() - d.getTime()) / 1000);
        if (ageS < 60) return (ageS|0) + 's ago';
        if (ageS < 3600) return ((ageS/60)|0) + 'm ago';
        if (ageS < 86400) return ((ageS/3600)|0) + 'h ago';
        return ((ageS/86400)|0) + 'd ago';
      }
      function esc(s) { return (s == null ? '' : String(s).replace(/[<>&"]/g, function(c){
        return ({ '<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;' })[c];
      })); }
      function render(s) {
        // Mission board
        if (board && s.board) {
          ['backlog','ready','running','review','blocked','done'].forEach(function(lane){
            var ol = board.querySelector('.rt-lane[data-lane="' + lane + '"] ol');
            if (!ol) return;
            var items = s.board[lane] || [];
            if (!items.length) {
              ol.innerHTML = '<li class="rt-empty">—</li>';
              return;
            }
            ol.innerHTML = items.map(function(b){
              return '<li><span class="role">' + esc(b.worker) + '</span>' +
                '<span class="goal">' + esc(b.goal) + '</span>' +
                (b.slug ? '<span class="slug">' + esc(b.slug) + '</span>' : '') +
                '</li>';
            }).join('');
          });
        }
        // Stats
        var stats = s.stats || {};
        function setStat(k, v) {
          var el = document.querySelector('#rt-stats dd[data-stat="' + k + '"]');
          if (el) el.textContent = v;
        }
        setStat('articles_touched_today', stats.articles_touched_today != null ? stats.articles_touched_today : 0);
        setStat('words_added', stats.words_added != null ? stats.words_added : 0);
        setStat('claims_filed', stats.claims_filed != null ? stats.claims_filed : 0);
        setStat('suspect_queue', stats.suspect_queue != null ? stats.suspect_queue : 0);
        setStat('drift_today', stats.drift_today != null ? stats.drift_today : 0);
        var gradesDl = document.getElementById('rt-grades');
        if (gradesDl) {
          var grades = stats.grades || {};
          var order = ['stub','start','c','b','ga','fa'];
          var rows = order.filter(function(g){ return grades[g]; })
            .map(function(g){ return '<dt>' + g.toUpperCase() + '</dt><dd>' + grades[g] + '</dd>'; });
          gradesDl.innerHTML = rows.length ? rows.join('') : '<dt class="rt-empty">No grades yet</dt><dd></dd>';
        }
        var cycleEl = document.getElementById('rt-cycle');
        var timeEl = document.getElementById('rt-time');
        var hashEl = document.getElementById('rt-hash');
        if (cycleEl) cycleEl.textContent = 'cycle ' + (s.cycle_id != null ? s.cycle_id : '—');
        if (timeEl) timeEl.textContent = fmtRel(s.generated_at);
        if (hashEl) hashEl.textContent = (s.article_set_hash || '').slice(0, 12) || '…';
      }
      function tick() {
        fetch('/snapshot.json', { cache: 'no-store' }).then(function(r){
          if (!r.ok) return;
          return r.json();
        }).then(function(s){ if (s) render(s); }).catch(function(){});
      }
      tick();
      setInterval(tick, POLL_MS);
    })();

    // Activity log — polls the team's running-state snapshot.
    (function () {
      var feed = document.getElementById('mtt-log');
      var footer = document.getElementById('mtt-log-footer');
      if (!feed) return;
      var MAX_ROWS = 30;
      var lastSig = '';
      var lastKnown = new Set();
      var POLL_MS = 15000;
      var lastPoll = 0;
      var firstRender = true;
      function fmtTime(ts) {
        try {
          var iso = /T/.test(ts) ? ts : ts.replace(' ', 'T') + 'Z';
          var d = new Date(iso);
          if (isNaN(d.getTime())) return ts;
          return d.toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour12: false });
        } catch (e) { return ts; }
      }
      function esc(s) { return String(s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      }); }
      function statusOf(action) {
        if (!action) return 'idle';
        var a = String(action).trim().toLowerCase();
        if (a === '' || a === 'idle') return 'idle';
        return 'working';
      }
      function rowHTML(e, flash) {
        var status = statusOf(e.action);
        var actionText = e.action && String(e.action).trim() ? e.action : 'idle';
        return '<div class="log-row' + (flash ? ' log-flash' : '') + '">' +
          '<span class="log-dot status-' + status + '">●</span>' +
          '<span class="log-time">' + fmtTime(e.ts) + '</span>' +
          '<span class="log-who">' + esc(e.who) + '</span>' +
          '<span class="log-arrow">·</span>' +
          '<span class="log-action">' + esc(actionText) + '</span>' +
          '</div>';
      }
      function render(events, newKeys) {
        if (!events || events.length === 0) {
          feed.innerHTML = '<div class="log-empty">No activity yet. The bureau is quiet.</div>';
          return;
        }
        var html = '';
        for (var i = 0; i < events.length; i++) {
          var e = events[i];
          var rowKey = e.ts + '::' + e.key + '::' + e.action;
          var flash = !firstRender && newKeys.has(rowKey);
          html += rowHTML({ ts: e.ts, who: e.label || e.key, action: e.action }, flash);
        }
        feed.innerHTML = html;
        firstRender = false;
      }
      function tick() {
        lastPoll = Date.now();
        fetch('/botnet-snapshot.json', { cache: 'no-store' }).then(function (r) {
          if (!r.ok) throw new Error('no snapshot');
          return r.json();
        }).then(function (snap) {
          var events = (snap.recent_events || []).slice(0, MAX_ROWS);
          var sig = events.map(function (e) { return e.ts + '|' + e.key + '|' + e.action; }).join('~');
          if (sig === lastSig) { return; }
          var newKeys = new Set();
          for (var i = 0; i < events.length; i++) {
            var k = events[i].ts + '::' + events[i].key + '::' + events[i].action;
            if (!lastKnown.has(k)) newKeys.add(k);
          }
          lastSig = sig;
          lastKnown = new Set(events.map(function (e) { return e.ts + '::' + e.key + '::' + e.action; }));
          render(events, newKeys);
        }).catch(function () { /* network blip */ });
      }
      function updateFooter() {
        if (!footer || !lastPoll) return;
        var ago = Math.max(0, Math.floor((Date.now() - lastPoll) / 1000));
        var next = Math.max(0, Math.floor(POLL_MS / 1000 - ago));
        footer.textContent = 'Last poll ' + ago + 's ago · next in ' + next + 's';
      }
      tick();
      setInterval(tick, POLL_MS);
      setInterval(updateFooter, 1000);
    })();

  </script>


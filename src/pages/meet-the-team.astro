---
import WikiLayout from '../layouts/WikiLayout.astro';
import { BOTS } from '../data/team.mjs';

// Group bots by role for the roster description list.
const byRole = {};
for (const b of BOTS) (byRole[b.role] ??= []).push(b);
const roleOrder = ['Discovery', 'Triage', 'Vetting', 'Transcription', 'Claim Extraction',
                   'Verification', 'Publishing', 'Steady-State', 'Cohesion'];
---
<WikiLayout
  title="Meet the team"
  description="The autonomous editorial bureau that builds KiriPedia — fourteen bots, each with one job."
>
  <div class="wiki-content">
    <h1 class="firstHeading">Meet the team</h1>
    <p class="subtitle">The autonomous editorial bureau that builds KiriPedia, with no human in the loop</p>

    <article class="wiki-body">
      <div class="hatnote" style="padding-left:0">
        Every article on KiriPedia is written, cited, and edited by this autonomous workforce. The bureau runs continuously on a public GitHub repository and commits its work back to the wiki without supervision. This page shows the office in real time.
      </div>

      <p>
        <strong>KiriPedia</strong> is built by a small editorial bureau of specialized software agents. Each agent does one part of the job — discovering new <a href="/wiki/john-kiriakou">John Kiriakou</a> appearances, transcribing them, extracting verifiable claims, checking those claims against the source transcripts, and merging the surviving claims into the right article. The pixel office below shows every agent at its desk, walking between desks when work is being handed off.
      </p>

      <p>
        Nothing on the wiki is published until the <em>Grounding Reviewer</em> confirms that the underlying quote really appears in the cited transcript at the cited timestamp. Claims that fail the check are quarantined permanently rather than escalated to a human — the bureau is, by design, completely unsupervised.
      </p>

      <h2 id="the-office">The office</h2>

      <figure id="mtt-office-figure" class="office-figure" style="margin:0 0 18px;border:1px solid var(--color-border);background:var(--color-bg-infobox);padding:8px;max-width:100%;">
        <iframe
          src="/office/index.html?embed=1"
          title="KiriPedia editorial bureau — live pixel office"
          class="office-iframe"
          style="width:100%;aspect-ratio:21/21;border:0;display:block;background:#1a1a1a;min-height:560px;"
        ></iframe>
        <figcaption>
          The bureau at work. Each desk belongs to one named agent. Hover any character in the office for its current activity. Outgoing handoffs animate as short walks between desks. The office refreshes every fifteen seconds from the same snapshot file the activity log reads.
        </figcaption>
      </figure>

      <h2 id="activity-log">Activity log</h2>

      <div id="mtt-orders-banner" class="orders-banner" style="display:none">
        <span class="orders-date" id="mtt-orders-date"></span>
        <span class="orders-text" id="mtt-orders-text"></span>
      </div>

      <p>
        Recent events from the bureau, newest first. Timestamps are shown in Eastern Time. The log refreshes every fifteen seconds.
      </p>

      <div class="log-wrap">
        <div id="mtt-log" class="wiki-log-feed">
          <div class="log-empty">Loading…</div>
        </div>
      </div>
      <div id="mtt-log-footer" class="log-footer">Last poll — · next in —</div>

      <h2 id="words-written">Words written</h2>

      <div id="mtt-words-box" class="words-box">
        <div class="words-today-row">
          <span class="words-today-label">Today</span>
          <span id="mtt-words-today" class="words-today-count">—</span>
          <span class="words-today-unit">words</span>
        </div>
        <div id="mtt-words-chart" class="words-chart" aria-label="Words written last 7 days">
          <div class="words-chart-bars" id="mtt-bars"></div>
          <div class="words-chart-labels" id="mtt-labels"></div>
        </div>
      </div>

      <h2 id="key-health">Key health</h2>

      <div id="mtt-keys-box" class="keys-box">
        <div class="keys-probe-row">
          <span class="keys-probe-label">Last probe</span>
          <span id="mtt-probe-time" class="keys-probe-time">—</span>
        </div>
        <div id="mtt-provider-grid" class="provider-grid"></div>
        <div class="keys-stats-row">
          <span class="keys-stat"><span id="mtt-calls-today" class="keys-stat-val">—</span> calls today</span>
          <span class="keys-stat-sep">·</span>
          <span class="keys-stat"><span id="mtt-cost-today" class="keys-stat-val">—</span> est. cost</span>
          <span class="keys-stat-sep">·</span>
          <span class="keys-stat"><span id="mtt-dead-keys" class="keys-stat-val">—</span> dead keys</span>
        </div>
      </div>

      <h2 id="pardon">Pardon and support</h2>

      <p>
        John Kiriakou served twenty-three months in federal prison following his 2012 prosecution under the <a href="/wiki/espionage-act">Espionage Act</a>. As a convicted federal felon he continues to be barred from voting, from exercising his Second Amendment right to keep and bear arms, and from receiving the federal pension he had earned over his fourteen years at the <a href="/wiki/cia">Central Intelligence Agency</a>. A presidential pardon would restore all three. Readers who wish to petition for a pardon on his behalf may do so by contacting their elected federal representatives.
      </p>

      <p>
        Readers who wish to support the continued work of KiriPedia — further article writing, ongoing refinement of existing articles, ingestion of new source material, and hosting costs — may send Bitcoin contributions to the following address:
      </p>

      <pre class="btc-address">bc1q0xcvzfrzmw482scntfq8l0mex90vfmyy05c83c</pre>

      <h2 id="roster">The full roster</h2>

      <p>
        Fourteen agents across nine roles. During the initial backfill of John Kiriakou's existing public appearances — roughly fifteen thousand clips spanning two decades — the discovery, triage, transcription, cataloging, and review desks are constantly busy. The steady-state pool (Deepener, Cross-Source Enricher, Article Weaver) takes over once the backfill is drained and keeps the bureau busy refining existing articles.
      </p>

      {roleOrder.filter(r => byRole[r]).map(role => (
        <section class="role-section">
          <h3>{role}</h3>
          <dl class="role-dl">
            {byRole[role].map(b => (
              <>
                <dt>
                  <span class="role-dot" style={`background:${b.color}`}></span>
                  {b.name}
                </dt>
                <dd>{b.description}</dd>
              </>
            ))}
          </dl>
        </section>
      ))}

      <h2 id="how-it-runs">How the bureau runs</h2>

      <p>
        The bureau operates as a pipeline of cron jobs running on a public GitHub repository. Discovery fires every six hours; triage and the full ingest cycle fire every fifteen minutes; the Article Weaver runs once a day. All language-model work is done by free worker models (Cerebras and Groq, via key rotation); all verification is done by deterministic code, not by AI judgment.
      </p>

      <p>
        Truth lives in a single SQLite database that all agents read and write. Only the <em>WikiProject Coordinator</em> ever touches the git repository, which means there are never merge conflicts between agents and the wiki is always in a coherent state. Claims that fail the grounding check enter a quarantine table that is never cleared and never reviewed — quarantine, by deliberate design, is a dead letter, not an inbox.
      </p>

      <p>
        For the underlying article-writing methodology — citation format, doctrine, source acceptance rules — see <a href="/about">About KiriPedia</a>. For the index of every transcript the bureau has consumed, see the <a href="/sources">Source index</a>.
      </p>
    </article>
  </div>

  <script is:inline>
    // Words-written widget — reads words_today + words_7d from the same snapshot.
    (function () {
      var todayEl = document.getElementById('mtt-words-today');
      var barsEl  = document.getElementById('mtt-bars');
      var labelsEl = document.getElementById('mtt-labels');
      if (!todayEl || !barsEl) return;
      var DAY_ABBR = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      function renderWords(snap) {
        var today = snap.words_today || 0;
        todayEl.textContent = today.toLocaleString();
        var days = snap.words_7d || [];
        if (!days.length) return;
        var max = Math.max(1, Math.max.apply(null, days.map(function(d){return d.words;})));
        var barsHtml = '', labelsHtml = '';
        for (var i = 0; i < days.length; i++) {
          var d = days[i];
          var pct = Math.round((d.words / max) * 100);
          var isToday = (i === days.length - 1);
          barsHtml += '<div class="wc-bar-wrap' + (isToday ? ' wc-today' : '') + '" title="' + d.date + ': ' + d.words.toLocaleString() + ' words">' +
            '<div class="wc-bar" style="height:' + pct + '%"></div>' +
            '</div>';
          var dayName = DAY_ABBR[new Date(d.date + 'T12:00:00Z').getUTCDay()];
          labelsHtml += '<span class="wc-label' + (isToday ? ' wc-today-label' : '') + '">' + dayName + '</span>';
        }
        barsEl.innerHTML = barsHtml;
        labelsEl.innerHTML = labelsHtml;
      }
      function fetchWords() {
        fetch('/botnet-snapshot.json', { cache: 'no-store' }).then(function(r){
          if (!r.ok) return;
          return r.json();
        }).then(function(snap) {
          if (!snap) return;
          if (snap.words_7d) renderWords(snap);
          if (window._renderOrders) window._renderOrders(snap);
          if (window._renderKeys) window._renderKeys(snap);
        }).catch(function(){});
      }
      fetchWords();
      setInterval(fetchWords, 15000);
    })();

    // Key health widget — reads office_state from the snapshot.
    (function () {
      var gridEl    = document.getElementById('mtt-provider-grid');
      var probeEl   = document.getElementById('mtt-probe-time');
      var callsEl   = document.getElementById('mtt-calls-today');
      var costEl    = document.getElementById('mtt-cost-today');
      var deadEl    = document.getElementById('mtt-dead-keys');
      if (!gridEl) return;
      var PRETTY = {
        'groq:gpt-oss-120b':    'GPT-OSS 120B',
        'groq:gpt-oss-20b':     'GPT-OSS 20B',
        'groq:llama-4-scout':   'Llama 4 Scout',
        'groq:llama-3.3-70b':   'Llama 3.3 70B',
        'cerebras:qwen-3-coder':'Qwen-3 Coder',
      };
      function fmtProbeTime(iso) {
        try {
          var d = new Date(iso);
          if (isNaN(d)) return iso;
          var ago = Math.floor((Date.now() - d) / 60000);
          return ago < 2 ? 'just now' : ago + 'm ago';
        } catch { return iso; }
      }
      function renderKeys(snap) {
        var os = snap.office_state;
        if (!os) return;
        var results = (os.last_probe && os.last_probe.results) || [];
        if (probeEl && os.last_probe) probeEl.textContent = fmtProbeTime(os.last_probe.at);
        if (callsEl) callsEl.textContent = (os.calls_today || 0).toLocaleString();
        if (costEl)  costEl.textContent  = os.cost_today < 0.01
          ? '<$0.01'
          : '$' + os.cost_today.toFixed(3);
        if (deadEl)  deadEl.textContent  = (os.dead_keys || 0);
        var html = '';
        for (var i = 0; i < results.length; i++) {
          var r = results[i];
          var ok = r.status === 'ok';
          var label = PRETTY[r.id] || r.id;
          var provider = r.id.split(':')[0];
          html += '<div class="provider-row">' +
            '<span class="provider-dot ' + (ok ? 'prov-ok' : 'prov-fail') + '">●</span>' +
            '<span class="provider-name">' + label + '</span>' +
            '<span class="provider-tag">' + provider + '</span>' +
            '<span class="provider-status ' + (ok ? 'prov-ok' : 'prov-fail') + '">' + (ok ? 'up' : 'down') + '</span>' +
            ((!ok && r.code) ? '<span class="provider-code">' + r.code + '</span>' : '') +
            '</div>';
        }
        gridEl.innerHTML = html || '<span class="keys-empty">No probe data yet.</span>';
      }
      window._renderKeys = renderKeys;
    })();

    // Orders of the Day banner — reads orders_today from the snapshot.
    (function () {
      var banner = document.getElementById('mtt-orders-banner');
      var dateEl = document.getElementById('mtt-orders-date');
      var textEl = document.getElementById('mtt-orders-text');
      if (!banner) return;
      function renderOrders(snap) {
        var o = snap.orders_today;
        if (!o) return;
        var pct = Math.round((o.total_words / o.goal) * 100);
        dateEl.textContent = 'Orders · ' + o.date + ' · ' + o.total_words.toLocaleString() + ' / ' + o.goal.toLocaleString() + ' words (' + pct + '%)';
        // Shorten the directive to the first sentence for the banner
        var short = (o.directive || '').split(/\.\s/)[0].replace(/^TODAY'S ORDERS \([^)]+\):\s*/i, '');
        textEl.textContent = short + '.';
        banner.style.display = '';
      }
      // Piggyback on the snapshot fetch — called after the snapshot loads
      window._renderOrders = renderOrders;
    })();

    // Activity log — polls the same snapshot file the office iframe reads.
    (function () {
      var feed = document.getElementById('mtt-log');
      var footer = document.getElementById('mtt-log-footer');
      if (!feed) return;
      var MAX_ROWS = 30;
      var lastSig = '';
      var lastKnown = new Set();
      var POLL_MS = 15000;
      var lastPoll = 0;
      var firstRender = true;
      function fmtTime(ts) {
        try {
          var iso = /T/.test(ts) ? ts : ts.replace(' ', 'T') + 'Z';
          var d = new Date(iso);
          if (isNaN(d.getTime())) return ts;
          return d.toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour12: false });
        } catch (e) { return ts; }
      }
      function esc(s) { return String(s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      }); }
      function statusOf(action) {
        if (!action) return 'idle';
        var a = String(action).trim().toLowerCase();
        if (a === '' || a === 'idle') return 'idle';
        return 'working';
      }
      function rowHTML(e, flash) {
        var status = statusOf(e.action);
        var actionText = e.action && String(e.action).trim() ? e.action : 'idle';
        return '<div class="log-row' + (flash ? ' log-flash' : '') + '">' +
          '<span class="log-dot status-' + status + '">●</span>' +
          '<span class="log-time">' + fmtTime(e.ts) + '</span>' +
          '<span class="log-who">' + esc(e.who) + '</span>' +
          '<span class="log-arrow">·</span>' +
          '<span class="log-action">' + esc(actionText) + '</span>' +
          '</div>';
      }
      function render(events, newKeys) {
        if (!events || events.length === 0) {
          feed.innerHTML = '<div class="log-empty">No activity yet. The bureau is quiet.</div>';
          return;
        }
        var html = '';
        for (var i = 0; i < events.length; i++) {
          var e = events[i];
          var rowKey = e.ts + '::' + e.key + '::' + e.action;
          var flash = !firstRender && newKeys.has(rowKey);
          html += rowHTML({ ts: e.ts, who: e.label || e.key, action: e.action }, flash);
        }
        feed.innerHTML = html;
        firstRender = false;
      }
      function tick() {
        lastPoll = Date.now();
        fetch('/botnet-snapshot.json', { cache: 'no-store' }).then(function (r) {
          if (!r.ok) throw new Error('no snapshot');
          return r.json();
        }).then(function (snap) {
          var events = (snap.recent_events || []).slice(0, MAX_ROWS);
          var sig = events.map(function (e) { return e.ts + '|' + e.key + '|' + e.action; }).join('~');
          if (sig === lastSig) { return; }
          var newKeys = new Set();
          for (var i = 0; i < events.length; i++) {
            var k = events[i].ts + '::' + events[i].key + '::' + events[i].action;
            if (!lastKnown.has(k)) newKeys.add(k);
          }
          lastSig = sig;
          lastKnown = new Set(events.map(function (e) { return e.ts + '::' + e.key + '::' + e.action; }));
          render(events, newKeys);
        }).catch(function () { /* network blip */ });
      }
      function updateFooter() {
        if (!footer || !lastPoll) return;
        var ago = Math.max(0, Math.floor((Date.now() - lastPoll) / 1000));
        var next = Math.max(0, Math.floor(POLL_MS / 1000 - ago));
        footer.textContent = 'Last poll ' + ago + 's ago · next in ' + next + 's';
      }
      tick();
      setInterval(tick, POLL_MS);
      setInterval(updateFooter, 1000);
    })();

    // Mobile tap-to-fullscreen overlay for the office iframe.
    (function () {
      if (!window.matchMedia || !window.matchMedia('(pointer: coarse)').matches) return;
      var figure = document.getElementById('mtt-office-figure');
      if (!figure) return;
      // A click guard at figure level intercepts the tap before it reaches the iframe.
      var guard = document.createElement('div');
      guard.className = 'mtt-tap-guard';
      guard.setAttribute('aria-label', 'Open office fullscreen');
      figure.style.position = 'relative';
      figure.appendChild(guard);
      guard.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openOverlay();
      });
      function openOverlay() {
        if (document.getElementById('mtt-office-overlay')) return;
        var overlay = document.createElement('div');
        overlay.id = 'mtt-office-overlay';
        overlay.className = 'mtt-office-overlay';
        var ifr = document.createElement('iframe');
        ifr.src = '/office/index.html?embed=1&fullscreen=1';
        ifr.title = 'KiriPedia editorial bureau — fullscreen';
        ifr.className = 'mtt-office-overlay-iframe';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mtt-office-overlay-close';
        btn.setAttribute('aria-label', 'Close fullscreen');
        btn.textContent = '×';
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          overlay.parentNode && overlay.parentNode.removeChild(overlay);
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
        });
        overlay.appendChild(ifr);
        overlay.appendChild(btn);
        document.body.appendChild(overlay);
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }
    })();
  </script>

  <style is:global>
    .office-figure {
      margin: 0 0 18px;
      border: 1px solid var(--color-border);
      background: var(--color-bg-infobox);
      padding: 8px;
      max-width: 100%;
    }
    .office-iframe {
      width: 100%;
      height: 640px;
      border: 0;
      display: block;
      background: #1a1a1a;
    }
    @media (max-width: 720px) {
      .office-iframe { height: 480px; }
    }
    .office-figure figcaption {
      font-size: 12px;
      color: var(--color-base--subtle);
      margin-top: 8px;
      line-height: 1.45;
      text-align: center;
    }

    .log-wrap {
      border: 1px solid var(--color-border);
      background: var(--color-bg-infobox);
      max-height: 360px;
      overflow-y: auto;
      margin-bottom: 4px;
    }
    .wiki-log-feed { font-size: 13px; }
    .wiki-log-feed .log-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 4px 10px;
      border-bottom: 1px solid var(--color-border-subtle);
      background: transparent;
      transition: background-color 2s linear;
    }
    .wiki-log-feed .log-row.log-flash { background: #fff3a8; transition: none; }
    .wiki-log-feed .log-dot {
      flex: 0 0 auto;
      font-size: 10px;
      line-height: 1;
    }
    .wiki-log-feed .log-dot.status-working { color: var(--color-success, #0a8754); }
    .wiki-log-feed .log-dot.status-idle { color: var(--color-base--subtle, #999); }
    .wiki-log-feed .log-time {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base--subtle);
      white-space: nowrap;
    }
    .wiki-log-feed .log-who {
      flex: 0 0 auto;
      font-weight: 600;
      color: var(--color-base);
      white-space: nowrap;
    }
    .wiki-log-feed .log-arrow {
      flex: 0 0 auto;
      color: var(--color-base--subtle);
    }
    .wiki-log-feed .log-action {
      flex: 1 1 auto;
      color: var(--color-base);
      word-break: break-word;
    }
    .wiki-log-feed .log-empty {
      text-align: center;
      color: var(--color-base--subtle);
      font-style: italic;
      padding: 20px;
    }
    .log-footer {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: var(--color-base--subtle);
      margin: 0 0 18px;
      padding: 2px 2px;
    }

    /* Mobile tap-to-fullscreen */
    .mtt-tap-guard {
      position: absolute;
      inset: 8px;
      z-index: 5;
      cursor: pointer;
      background: transparent;
    }
    .mtt-office-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #1a1a1a;
    }
    .mtt-office-overlay-iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: #1a1a1a;
    }
    .mtt-office-overlay-close {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      border: 1px solid rgba(255,255,255,0.7);
      background: rgba(0,0,0,0.55);
      color: #fff;
      font-family: sans-serif;
      font-size: 26px;
      line-height: 1;
      padding: 0;
      border-radius: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Key health widget */
    .keys-box {
      border: 1px solid var(--color-border);
      background: var(--color-bg-infobox);
      padding: 12px 16px 10px;
      margin-bottom: 18px;
      max-width: 480px;
    }
    .keys-probe-row {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-bottom: 10px;
    }
    .keys-probe-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--color-base--subtle);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .keys-probe-time {
      font-size: 11px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base--subtle);
    }
    .provider-grid {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-bottom: 10px;
    }
    .provider-row {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      padding: 2px 0;
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .provider-row:last-child { border-bottom: none; }
    .provider-dot { font-size: 10px; flex: 0 0 auto; }
    .prov-ok  { color: var(--color-success, #0a8754); }
    .prov-fail { color: #c00; }
    .provider-name {
      flex: 1;
      font-weight: 600;
      color: var(--color-base);
      white-space: nowrap;
    }
    .provider-tag {
      flex: 0 0 auto;
      font-size: 10px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--color-base--subtle);
      background: var(--color-bg-sidebar, #f0f0f0);
      padding: 1px 5px;
      border-radius: 2px;
    }
    .provider-status {
      flex: 0 0 auto;
      font-size: 11px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .provider-code {
      flex: 0 0 auto;
      font-size: 10px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #c00;
    }
    .keys-stats-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--color-base--subtle);
    }
    .keys-stat-val {
